{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wayland Voice Control local settings",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model_path", "microphone_consent", "confirmation_ttl_seconds", "focus_delay_seconds", "capture_limit_seconds", "theme"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1, "default": 1},
    "model_path": {
      "type": "string", "maxLength": 4096,
      "pattern": "^(?![\\s\\S]*://)[^\\u0000\\ud800-\\udfff]*$",
      "default": "",
      "description": "Local model directory; an empty string means no model is selected. Existence is checked when loading speech recognition."
    },
    "microphone_consent": {"type": "boolean", "default": false},
    "confirmation_ttl_seconds": {"type": "number", "minimum": 10, "maximum": 120, "default": 30},
    "focus_delay_seconds": {"type": "number", "minimum": 2, "maximum": 10, "default": 3},
    "capture_limit_seconds": {"type": "number", "minimum": 5, "maximum": 60, "default": 30},
    "theme": {"type": "string", "enum": ["system", "light", "dark"], "default": "system"}
  }
}
